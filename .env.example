NODE_ENV=development
APP_NAME=nestjs-production-base
PORT=8017
API_PREFIX=v1
FRONTEND_URL=http://localhost:3000
WEBSITE_DOMAIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Base URL công khai của chính BE - dùng để build link download attachment.
# Mặc định http://localhost:{PORT}. Đổi khi deploy (vd https://api.yourdomain.com)
APP_PUBLIC_URL=http://localhost:8017
LOG_DIR=logs
LOG_MAX_FILE_SIZE_BYTES=10485760

# Upload / attachments
# Driver lưu trữ: 'local' (ổ đĩa, mặc định) hoặc 's3'
STORAGE_DRIVER=local

# --- Local driver ---
# Thư mục lưu file upload (tương đối với thư mục chạy app)
UPLOAD_DIR=uploads
# URL công khai để build link file (khớp host:port BE). Mặc định http://localhost:{PORT}/uploads
UPLOAD_BASE_URL=http://localhost:8017/uploads

# --- S3 driver (chỉ dùng khi STORAGE_DRIVER=s3) ---
S3_REGION=ap-southeast-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Endpoint tuỳ chọn cho MinIO / Cloudflare R2 / ... (để trống nếu dùng AWS S3)
S3_ENDPOINT=
# 'true' nếu S3-compatible cần path-style (vd MinIO)
S3_FORCE_PATH_STYLE=false
# Prefix key trong bucket
S3_KEY_PREFIX=attachments
# URL công khai để build link tải (CDN / custom domain). Để trống sẽ tự suy ra
S3_PUBLIC_URL=

BREVO_API_KEY=
MAIL_SENDER_EMAIL=no-reply@example.com
MAIL_SENDER_NAME=Backlog App

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=be_02
POSTGRES_SCHEMA=public
DOCKER_POSTGRES_HOST=postgres

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REDIS_HOST=localhost
DOCKER_REDIS_HOST=redis
REDIS_PORT=6379
